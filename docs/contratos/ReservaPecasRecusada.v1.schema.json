{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReservaPecasRecusada v1",
  "description": "Evento Execucao -> OS: falta estoque; nada foi reservado (a reserva e atomica). Canal: SNS mecanica-execucao-eventos. Payload do envelope (envelope.schema.json) com type=ReservaPecasRecusada e version=1.",
  "type": "object",
  "required": [
    "osId",
    "faltantes"
  ],
  "additionalProperties": true,
  "properties": {
    "osId": {
      "type": "string",
      "format": "uuid"
    },
    "faltantes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "pecaId",
          "solicitada",
          "disponivel"
        ],
        "additionalProperties": true,
        "properties": {
          "pecaId": {
            "type": "string",
            "format": "uuid"
          },
          "solicitada": {
            "type": "integer",
            "minimum": 1
          },
          "disponivel": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
