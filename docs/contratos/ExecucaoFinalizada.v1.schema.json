{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecucaoFinalizada v1",
  "description": "Evento Execucao -> OS: execucao finalizada, com o tempo gasto em cada servico. Canal: SNS mecanica-execucao-eventos. Payload do envelope (envelope.schema.json) com type=ExecucaoFinalizada e version=1.",
  "type": "object",
  "required": [
    "osId",
    "finalizadaEm",
    "tempos"
  ],
  "additionalProperties": true,
  "properties": {
    "osId": {
      "type": "string",
      "format": "uuid"
    },
    "finalizadaEm": {
      "type": "string",
      "format": "date-time"
    },
    "tempos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "servicoId",
          "minutos"
        ],
        "additionalProperties": true,
        "properties": {
          "servicoId": {
            "type": "string",
            "format": "uuid"
          },
          "minutos": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
